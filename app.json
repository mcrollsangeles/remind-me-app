{
  "expo": {
    "name": "Remind Me",
    "slug": "remind-me-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/psyduck-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFC400",
        "foregroundImage": "./assets/psyduck-icon.png"
      },
      "package": "com.mc.angeles.remindmeapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "sounds": [
            "./assets/psyduck.mp3"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/psyduck-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFC400"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "15554fff-1552-42c8-a47b-47406cb534d9"
      }
    },
    "owner": "mc.angeles"
  }
}